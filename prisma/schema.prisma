generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id             String       @id @default(cuid())
  name           String
  slug           String       @unique
  logo           String?
  createdAt      DateTime     @default(now())
  matchDays      String[]
  matchDuration  Int          @default(90)
  matchesPerDay  Int          @default(2)
  roundTrip      Boolean      @default(false)
  startDate      DateTime?
  bannerUrl      String?
  contactEmail   String?
  contactName    String?
  contactPhone   String?
  description    String?
  endDate        DateTime?
  facebook       String?
  inscriptionFee Float?
  instagram      String?
  maxTeams       Int?
  published      Boolean      @default(false)
  whatsapp       String?
  finances       Finance[]
  matches        Match[]
  referees       Referee[]
  rounds         Round[]
  teams          Team[]
  users          TenantUser[]
  archived       Boolean      @default(false)

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  // NUEVO
  folderId       String?
  folder         TenantFolder? @relation(fields: [folderId], references: [id])

  @@index([folderId])
  @@index([organizationId])
}

model Organization {
  id        String       @id @default(cuid())
  name      String
  slug      String       @unique
  logo      String?
  createdAt DateTime     @default(now())

  tenants  Tenant[]
  users    OrgUser[]
  folders  TenantFolder[]
}
model TenantFolder {
  id             String       @id @default(cuid())
  name           String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  tenants        Tenant[]

  @@index([organizationId])
}
model OrgUser {
  id             String       @id @default(cuid())
  role           Role         @default(VIEWER)
  userId         String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  user           User         @relation(fields: [userId], references: [id])

  @@unique([userId, organizationId])
}

model User {
  id           String       @id @default(cuid())
  email        String?      @unique
  name         String?
  password     String?
  isSuperAdmin Boolean      @default(false)
  phone        String?      @unique
  tenants      TenantUser[]
  organizations OrgUser[]
}

model TenantUser {
  id       String        @id @default(cuid())
  role     Role          @default(VIEWER)
  userId   String
  tenantId String
  tenant   Tenant        @relation(fields: [tenantId], references: [id])
  user     User          @relation(fields: [userId], references: [id])
  teams    TeamCaptain[]

  @@unique([userId, tenantId])
}

model TeamCaptain {
  id           String     @id @default(cuid())
  tenantUserId String
  teamId       String
  createdAt    DateTime   @default(now())
  tenantUser   TenantUser @relation(fields: [tenantUserId], references: [id])
  team         Team       @relation(fields: [teamId], references: [id])

  @@unique([tenantUserId, teamId])
}

model Team {
  id           String        @id @default(cuid())
  name         String
  logo         String?
  tenantId     String
  captain      String?
  phone        String?
  disqualified Boolean       @default(false)
  finances     Finance[]
  awayMatches  Match[]       @relation("AwayTeam")
  homeMatches  Match[]       @relation("HomeTeam")
  players      Player[]
  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  captains     TeamCaptain[]
  preferredDay String?
}

model Player {
  id       String      @id @default(cuid())
  name     String
  number   Int?
  position String?
  photo    String?
  teamId   String
  team     Team        @relation(fields: [teamId], references: [id])
  stats    PlayerStat[]
}

model Round {
  id           String  @id @default(cuid())
  number       Int
  name         String?
  tenantId     String
  bracketLabel String?
  bracketStage Int?
  matches      Match[]
  tenant       Tenant  @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, number])
}

model Match {
  id           String       @id @default(cuid())
  date         DateTime
  homeScore    Int?
  awayScore    Int?
  status       MatchStatus  @default(SCHEDULED)
  tenantId     String
  homeTeamId   String
  awayTeamId   String
  refereeId    String?
  roundId      String?
  cancha       Int?
  bracketOrder Int?
  awayTeam     Team         @relation("AwayTeam", fields: [awayTeamId], references: [id])
  homeTeam     Team         @relation("HomeTeam", fields: [homeTeamId], references: [id])
  referee      Referee?     @relation(fields: [refereeId], references: [id])
  round        Round?       @relation(fields: [roundId], references: [id])
  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  events       MatchEvent[]
}

model MatchEvent {
  id              String     @id @default(cuid())
  type            EventType
  minute          Int
  matchId         String
  playerId        String
  suspensionGames Int?
  match           Match      @relation(fields: [matchId], references: [id])
  player          PlayerStat @relation(fields: [playerId], references: [id])
}

model PlayerStat {
  id       String       @id @default(cuid())
  goals    Int          @default(0)
  assists  Int          @default(0)
  yellow   Int          @default(0)
  red      Int          @default(0)
  playerId String       @unique
  events   MatchEvent[]
  player   Player       @relation(fields: [playerId], references: [id])
}

model Referee {
  id          String  @id @default(cuid())
  name        String
  tenantId    String
  email       String?
  notes       String?
  payPerMatch Float   @default(0)
  phone       String?
  matches     Match[]
  tenant      Tenant  @relation(fields: [tenantId], references: [id])
}

model Finance {
  id          String          @id @default(cuid())
  type        FinanceType
  amount      Float
  description String?
  date        DateTime        @default(now())
  tenantId    String
  category    FinanceCategory @default(OTRO)
  teamId      String?
  team        Team?           @relation(fields: [teamId], references: [id])
  tenant      Tenant          @relation(fields: [tenantId], references: [id])
}

enum Role {
  SUPER_ADMIN
  ADMIN
  VIEWER
  CAPTAIN
}

enum MatchStatus {
  SCHEDULED
  LIVE
  FINISHED
  CANCELLED
}

enum EventType {
  GOAL
  YELLOW_CARD
  RED_CARD
  SUBSTITUTION
}

enum FinanceType {
  INCOME
  EXPENSE
}

enum FinanceCategory {
  CUOTA_EQUIPO
  PAGO_ARBITRO
  GASTO_CANCHA
  GASTO_TROFEOS
  GASTO_GENERAL
  PREMIO
  OTRO
}